# Python
__pycache__/
*.pyc

# The full-size elevation raster is 64 MB. Tools > FireCA > Setup > Generate Default Scenarios writes the file again.
/unity/Assets/StreamingAssets/Scenarios/synthetic-canyon-01/elevation.r32

# The South Canyon elevation raster is 64 MB. tools/import_canyon.py writes the file again from data/south-canyon/source.
/unity/Assets/StreamingAssets/Scenarios/south-canyon/elevation.r32

# The real-world source data is about 300 MB. The rasters, the images, and the report PDFs stay out of git.
# The README, the fetch scripts, the prepared scenario.json, and the perimeter files are in git.
/data/**/*.tif
/data/**/*.r32
/data/**/*.png
/data/**/*.jpg
/data/**/*.pdf
